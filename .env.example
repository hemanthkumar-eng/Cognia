# App -> backend URL. For a physical device, use your computer's LAN IP.
# Find it with: ipconfig getifaddr en0   (mac)
# Leave unset to use the per-platform defaults in src/lib/config.ts
#   (iOS sim: localhost, Android emulator: 10.0.2.2)
EXPO_PUBLIC_API_URL=http://192.168.1.5:3000

# Real-time streaming voice (Phase 2). Set to 1 to stream mic PCM over WebSocket
# for live captions + lower-latency replies. Requires a dev build (native audio
# module) and a live SARVAM_API_KEY on the server. Leave unset for the stable
# turn-based (record → upload) path.
EXPO_PUBLIC_STREAMING=0
