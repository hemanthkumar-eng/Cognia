# Sarvam AI API key — get one at https://dashboard.sarvam.ai (keep this server-side ONLY)
SARVAM_API_KEY=

# Server port
PORT=3000

# Models (override if Sarvam updates names)
SARVAM_STT_MODEL=saaras:v2.5
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_LLM_MODEL=sarvam-m

# Real-time streaming STT (/api/stream WebSocket bridge)
SARVAM_STT_STREAM_MODEL=saaras:v3
# Per-chunk `audio.encoding` value sent to Sarvam's streaming STT. We stream raw
# PCM16 (input_audio_codec=pcm_s16le); reference impls send "audio/wav" here.
# VERIFY against a live key — if streaming STT returns empty/garbled transcripts,
# this is the first knob to try.
SARVAM_STT_AUDIO_ENCODING=audio/wav

# Default TTS speaker (see https://docs.sarvam.ai for the current voice list)
SARVAM_TTS_SPEAKER=anushka

# Per-session safety caps (cost guardrails for minors / runaway usage)
MAX_LLM_OUTPUT_TOKENS=300
MAX_HISTORY_TURNS=12
